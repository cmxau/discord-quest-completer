.env
.env.*
!.env.example
*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Editors & OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace
.claude/settings.local.json
.DS_Store
Thumbs.db
Desktop.ini
