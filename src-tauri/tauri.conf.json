{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Quest Completer",
  "version": "26.10.2",
  "identifier": "io.github.cmxau.discordquestcompleter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Quest Completer",
        "width": 800,
        "height": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost", 
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  }, 
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "cmxau",
    "copyright": "Copyright (c) 2026 cmxau. Original work Copyright (c) 2025 Mark Terence Tiglao.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/cmxau/discord-quest-completer",
    "resources": [
      "resources/*"
    ]
  }
}